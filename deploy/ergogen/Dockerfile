# One Ergogen version per image tag, so a repo is generated by the engine its own
# config names (`meta.engine`). Installed at build time, never at run time: the
# generate step runs this with --network none, because the footprints it executes
# are the repo author's JavaScript. See scripts/generate_ergogen.py.
FROM docker.io/library/node:22
ARG ERGOGEN_VERSION
RUN test -n "$ERGOGEN_VERSION" && npm install -g "ergogen@${ERGOGEN_VERSION}" \
    && npm cache clean --force
USER node
ENTRYPOINT ["ergogen"]
