@import net.keyboardbuilders.keyboardbuilders.web.Head
@import net.keyboardbuilders.keyboardbuilders.web.SiteUrl
@import net.keyboardbuilders.keyboardbuilders.moderation.QuestionView
@import org.springframework.security.web.csrf.CsrfToken
@param head: Head
@param site: SiteUrl
@param question: QuestionView?
@param remaining: Int
@param csrf: CsrfToken

<%--
    Backlog #117: the intake bot's questions, one at a time (ModerateController). Same
    frame as /account. bodyHtml is rendered by QuestionMarkdown with every raw HTML tag
    escaped, which is why it may go out unescaped here. NO BACKTICKS anywhere in this
    file -- one closes the raw string the page is written in.
--%>
@template.layout(head = head, site = site, content = @`
    <article class="settings moderate">
        <h1>Moderate</h1>
        @if(question == null)
            <section class="settings-card">
                <h2>Nothing to answer</h2>
                <p class="settings-q">The bot asks again after its next run.</p>
            </section>
        @else
            <p class="settings-lede">${remaining} open</p>
            <section class="settings-card">
                <h2>${question.title}</h2>
                <div class="moderate-body">$unsafe{question.bodyHtml}</div>
                <form method="post" action="/moderate/answer" class="moderate-choices">
                    <input type="hidden" name="${csrf.parameterName}" value="${csrf.token}">
                    <input type="hidden" name="id" value="${question.id}">
                    @for(choice in question.choices)
                        <button type="submit" name="reply" value="${choice.reply}" class="settings-save">${choice.label}</button>
                    @endfor
                </form>
            </section>
        @endif
    </article>
    <%-- PHOTOS AS THUMBNAILS, opened in the same PhotoSwipe the design pages use: click to
         see one full size, zoom, and step through the question's other photos. Each
         image's real size is read once it has loaded, since PhotoSwipe scales a picture
         to the size it is told. --%>
    <script type="module">
        const images = Array.from(document.querySelectorAll(".moderate-body img"));
        let lightbox = null;
        function stylesheet(href) {
            return new Promise((resolve) => {
                const link = document.createElement("link");
                link.rel = "stylesheet";
                link.href = href;
                link.onload = resolve;
                document.head.appendChild(link);
            });
        }
        // A photo's title is the heading just above it in the question
        // ("1 -- alt text: ..."), so the caption says which number to press.
        function titleOf(img) {
            const block = img.closest("p") || img;
            const before = block.previousElementSibling;
            return before && /^H[1-6]$/.test(before.tagName) ? before.textContent.trim() : img.alt;
        }
        async function open(index) {
            if (!lightbox) {
                const [{ default: PhotoSwipeLightbox }] = await Promise.all([
                    import("/vendor/photoswipe-lightbox-5.4.4.esm.min.js"),
                    stylesheet("/vendor/photoswipe-5.4.4.css"),
                ]);
                lightbox = new PhotoSwipeLightbox({
                    dataSource: images.map((img) => ({
                        src: img.src, alt: img.alt, caption: titleOf(img),
                        width: img.naturalWidth || 1600, height: img.naturalHeight || 1200,
                    })),
                    pswpModule: () => import("/vendor/photoswipe-5.4.4.esm.min.js"),
                });
                // The design page's caption, the same class and placement.
                lightbox.on("uiRegister", () => {
                    lightbox.pswp.ui.registerElement({
                        name: "caption", order: 9, isButton: false, appendTo: "root",
                        onInit: (el, pswp) => {
                            el.className = "pswp-caption";
                            const update = () => {
                                const data = pswp.currSlide && pswp.currSlide.data;
                                el.textContent = (data && data.caption) || "";
                                el.hidden = !el.textContent;
                            };
                            pswp.on("change", update);
                            update();
                        },
                    });
                });
                lightbox.init();
            }
            lightbox.loadAndOpen(index);
        }
        images.forEach((img, i) => img.addEventListener("click", () => open(i)));
    </script>
`)
