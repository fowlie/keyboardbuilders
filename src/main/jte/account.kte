@import net.keyboardbuilders.keyboardbuilders.web.Head
@import net.keyboardbuilders.keyboardbuilders.web.SiteUrl
@import net.keyboardbuilders.keyboardbuilders.account.OwnedDesign
@import net.keyboardbuilders.keyboardbuilders.account.PhotoTaskOffer
@import org.springframework.security.web.csrf.CsrfToken
@param head: Head
@param site: SiteUrl
@param login: String
@param designs: List<OwnedDesign>
@param csrf: CsrfToken
@param photos: String? = null
@param task: PhotoTaskOffer? = null

<%--
    "Your designs", backlog #116 (AccountController). Built from /settings' pieces: the
    same column, a raised card, and key-shaped buttons. NO BACKTICKS anywhere in this
    file -- one closes the raw string the page is written in.
--%>
@template.layout(head = head, site = site, content = @`
    <article class="settings account">
        <h1>Your account</h1>
        <div class="account-who">
            <p class="settings-lede">Signed in with GitHub as <strong>${login}</strong>.</p>
            <form method="post" action="/logout">
                <input type="hidden" name="${csrf.parameterName}" value="${csrf.token}">
                <button type="submit" class="settings-save">Sign out</button>
            </form>
        </div>

        <%-- ONE TASK, the first thing after signing in (owner, 2026-11-25). --%>
        @if(task != null)
            <section class="settings-card task">
                <h2>Have you built a ${task.name}?</h2>
                <div class="owned-row">
                    <span class="owned-pic">$unsafe{task.silhouette}</span>
                    <span class="owned-text">
                        <span class="owned-state">It has no build photo yet. A photo of yours earns 10 points once it is approved.</span>
                    </span>
                </div>
                <p class="settings-q">
                    <a class="task-go" href="/designs/${task.slug}/photo">Add your photo</a>
                    &middot; <a href="/account?task=${task.next}">Not built one? Show another</a>
                </p>
            </section>
        @endif

        @if(photos != null)
            <section class="settings-card">
                <h2>Your build photos</h2>
                <p class="settings-q">${photos} <a href="/builders/${login.lowercase()}">See your page</a></p>
            </section>
        @endif

        <section class="settings-card">
            @if(designs.isEmpty())
                <h2>Nothing here yet</h2>
                <p class="settings-q">
                    No designs on this site come from a GitHub account named ${login}.
                </p>
                <p class="settings-fine">
                    If one is yours under another account or an organisation, email
                    <a href="mailto:hello@keyboardbuilders.net">hello@keyboardbuilders.net</a>.
                </p>
            @else
                <h2>@if(designs.size == 1)1 design@else${designs.size} designs@endif from github.com/${login}</h2>
                <ul class="owned">
                    @for(design in designs)
                        <li class="owned-row${if (design.published) "" else " is-off"}">
                            <span class="owned-pic">$unsafe{design.silhouette}</span>
                            <span class="owned-text">
                                @if(design.published)
                                    <a href="/designs/${design.slug}">${design.name}</a>
                                    <span class="owned-state">On the site</span>
                                @else
                                    <strong>${design.name}</strong>
                                    <span class="owned-state">Unpublished. Its page says you took it down.</span>
                                @endif
                            </span>
                            @if(design.published)
                                <a class="settings-save owned-edit" href="/designs/${design.slug}/correct">Edit</a>
                                <form method="post" action="/account/designs/${design.slug}/unpublish">
                                    <input type="hidden" name="${csrf.parameterName}" value="${csrf.token}">
                                    <button type="submit" class="key-quiet">Unpublish</button>
                                </form>
                            @else
                                <form method="post" action="/account/designs/${design.slug}/publish">
                                    <input type="hidden" name="${csrf.parameterName}" value="${csrf.token}">
                                    <button type="submit" class="settings-save">Publish again</button>
                                </form>
                            @endif
                        </li>
                    @endfor
                </ul>
                <p class="settings-fine">
                    Unpublishing takes a design out of search, lists and the sitemap at once.
                    You can publish it again here whenever you like.
                </p>
            @endif
        </section>
    </article>
`)
