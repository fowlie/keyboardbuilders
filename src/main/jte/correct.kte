@import net.keyboardbuilders.keyboardbuilders.community.CorrectionCard
@import net.keyboardbuilders.keyboardbuilders.web.Head
@import net.keyboardbuilders.keyboardbuilders.web.SiteUrl
@import org.springframework.security.web.csrf.CsrfToken
@param head: Head
@param site: SiteUrl
@param slug: String
@param name: String
@param silhouette: String
@param cards: List<CorrectionCard>
@param designer: Boolean
@param csrf: CsrfToken

<%--
    Correct a design's measured facts (CorrectionController): one card per fact, the
    current answer pressed, one Save. Answers are keys, the same as /settings.
    NO BACKTICKS anywhere in this file -- one closes the raw string the page is written in.
--%>
@template.layout(head = head, site = site, content = @`
    <p class="crumb"><a href="/designs/${slug}">&larr; ${name}</a></p>
    <article class="settings correct">
        <header class="correct-head">
            <span class="correct-pic">$unsafe{silhouette}</span>
            <div>
                <h1>Correct ${name}</h1>
                @if(designer)
                    <p class="settings-lede">These were measured from the board files, and measuring gets some boards wrong. You designed this one, so what you save is on the page straight away.</p>
                @else
                    <p class="settings-lede">Only the designer can correct these for now. If one is wrong, email <a href="mailto:hello@keyboardbuilders.net">hello@keyboardbuilders.net</a>.</p>
                @endif
            </div>
        </header>
        <form method="post" action="/designs/${slug}/correct">
            <input type="hidden" name="${csrf.parameterName}" value="${csrf.token}">
            @for(card in cards)
                <fieldset class="settings-card correct-card" disabled="${!designer}">
                    <legend class="correct-legend">${card.heading}</legend>
                    <p class="settings-q">${card.question}</p>
                    <div class="fact-choices${if (card.choices.any { it.icon != null }) "" else " fact-choices-words"}">
                        @for(c in card.choices)
                            <label class="choice fact-choice">
                                <input type="${if (card.many) "checkbox" else "radio"}" name="${card.name}" value="${c.value}" checked="${c.checked}">
                                @if(c.icon != null)
                                    <span class="fact-pic">$unsafe{c.icon}</span>
                                @endif
                                <span class="choice-text">
                                    <strong>${c.label}</strong>
                                    @if(c.detail != null)<span>${c.detail}</span>@endif
                                </span>
                            </label>
                        @endfor
                    </div>
                </fieldset>
            @endfor
            @if(designer)
                <div class="correct-bar">
                    <a class="correct-cancel" href="/designs/${slug}">Cancel</a>
                    <button type="submit" class="key-primary">Save</button>
                </div>
            @endif
        </form>
    </article>
`)
