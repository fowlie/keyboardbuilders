@import net.keyboardbuilders.keyboardbuilders.web.DesignPage
@import net.keyboardbuilders.keyboardbuilders.web.Head
@import net.keyboardbuilders.keyboardbuilders.web.SiteUrl
@param design: DesignPage
@param head: Head
@param site: SiteUrl
@param hearts: Int = 0
@param renderLeads: Boolean = false

@template.layout(head = head, site = site, content = @`
    <p class="crumb"><a href="/designs">&larr; All designs</a></p>

    <%-- THE FAMILY, backlog #107, beside the title: "Corne Chocolate v4 from the Corne
         family" (owner, 2026-10-04), the name linking the family page, which lists and
         compares every member. No count -- "2 of 2 designs" told a reader nothing. Absent
         for a design in no recorded family. --%>
    !{val family = design.family}
    <div class="title">
        <h1>${design.name}</h1>
        @if(family != null)
            <p class="family">from the <a href="${family.href}">${family.name} family</a></p>
        @endif
    </div>
    <%-- WHO PUBLISHED IT, read from the repo the design cites rather than stored. In this
         hobby a board is known as "the Sofle, by Josef Adamcik" and the catalogue was
         printing only the first half.

         It says "by" and not "Designed by" on purpose: what is known is who owns the
         repository, and "by" is how the hobby itself credits a board. For 229 of 234 that is the same person; for the 5 whose repo is a
         fork it is the author of THAT variant, which is still the right credit for THIS
         record. The ancestor credit is based_on, Forgejo #24, below. --%>
    <%-- Bound to a local because Kotlin will not smart-cast a nullable public property
         from another module, and the generated template IS another module -- same fix
         as facetGroup.kte's "unrecorded", applied here after it broke bootRun's dev
         mode (on-demand compiler); the precompiled build path tolerates it fine. --%>
    !{val author = design.author}
    <%-- STARS JOINED THE BYLINE 2026-09-25, when the Spec table was grouped: a star count
         is about the project, not the keyboard. An unknown still says so, never 0 and
         never blank -- ux.md 5.3's rule for this page moved with it. --%>
    <p class="byline">
        @if(author != null)
            by <a href="${author.url}" rel="nofollow noopener">${author.handle}</a> &middot;
        @endif
        @if(design.stars.recorded)
            <span class="byline-stars">&#9733; ${design.stars.value}</span>
        @else
            <span class="byline-stars unrecorded">&#9733; stars ${design.stars.value}</span>
        @endif
        <%-- OUR OWN HEARTS, beside GitHub's stars for now: every design starts at zero, so
             the stars stay until hearts mean something to sort by. The count is the
             server's; whether YOU hearted it is this browser's, filled in by the script
             at the end of the page. Disabled until then, so it does nothing without JS. --%>
        &middot; <button type="button" class="heart" data-slug="${design.slug}" aria-pressed="false" disabled
                title="Heart this design to keep it in your favorites"><span class="heart-icon" aria-hidden="true">&#9825;</span> <span class="heart-count">${hearts}</span></button>
    </p>

    <%-- based_on, Forgejo #24. Absent for the common case (no explicit credit found) --
         the page says nothing rather than "not recorded", same as summary just above.
         An external ancestor (ticket 22) opens in a new tab and says so, same rule
         sources.kte already follows for a link that leaves the site; an internal one is
         a plain link to the page this site actually has for it. --%>
    @if(!design.basedOn.isEmpty())
        <p class="based-on">derived from
            @for((i, ancestor) in design.basedOn.withIndex())
                @if(i > 0), @endif
                @if(ancestor.external)
                    <a class="external" href="${ancestor.href}" rel="nofollow noopener" target="_blank">${ancestor.name}<span class="ext" aria-hidden="true">&#8599;</span></a>
                @else
                    <a href="${ancestor.href}">${ancestor.name}</a>
                @endif
            @endfor
        </p>
    @endif

    <%-- MOVED ABOVE THE BOARD/PHOTO FIGURES, 2026-09-17: with both a render and a real
         photo now possible on the same page, two full-width figures stacked before these
         chips pushed the design's basic facts out of the first screenful. The chips are
         cheap to read and belong near the name, not after two pictures. --%>
    <p class="facts">
        @for(chip in design.shape)
            <span>${chip}</span>
        @endfor
    </p>
    <p class="facts">
        @for(chip in design.electronics)
            <span>${chip}</span>
        @endfor
    </p>

    <%-- ONE BIG PICTURE, THEN A RAIL OF THE OTHERS -- owner's design, 2026-09-17: "I want
         one big photo on the details page, and then other photos could be on a small rail
         below that."

         THE HERO IS THE PHOTO WHERE THERE IS ONE, THE BARE PCB RENDER WHERE THERE IS NOT
         (owner's ruling the same day: "if no photo, show the pcb render"). Never the
         silhouette -- that already has its own home under Layouts below, and hoisting it
         up here would print the identical picture twice on the same page, which is the
         exact thing moving it into Layouts fixed. A design with neither shows nothing at
         all here, about 2 of 325 after backlog #60's corpus render, rather than a
         placeholder standing in for a picture nobody has.

         ux.md 3.5's rule that a render never REPLACES the silhouette still holds: the
         silhouette is still drawn, still from the key positions, just further down beside
         the layouts it describes.

         /settings CAN PUT THE RENDER FIRST (owner, 2026-10-02), for browsing a family's
         boards one after another; then the photo moves to the rail below. --%>
    @if(design.photo != null && !renderLeads)
        !{val photo = design.photo!!}
        <figure class="hero">
            <a class="hero-shot" data-hero="photo" href="${photo.url}">
                <img src="${photo.url}" width="${photo.width}" height="${photo.height}"
                     alt="Photo of an assembled ${design.name}">
            </a>
            @if(photo.creditUrl != null)
                <figcaption>An assembled ${design.name}. Photo: <a class="external" href="${photo.creditUrl}" rel="nofollow noopener" target="_blank" title="Opens in a new tab">${photo.creditName}<svg class="ext" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>.</figcaption>
            @else
                <figcaption>An assembled ${design.name}, from the project's own README.</figcaption>
            @endif
        </figure>
    @elseif(design.render != null)
        !{val render = design.render!!}
        <%-- data-hero="render" tells the gallery script that this picture and the 3D
             slide's opening poster are the same file, so it must not make two slides of
             it -- see the script for what it does instead. --%>
        <figure class="hero">
            <a class="hero-shot" data-hero="render" href="${render.poster}">
                <img src="${render.poster}" width="1400" height="900"
                     alt="3D render of the ${design.name} circuit board">
            </a>
            <figcaption>
                The bare PCB, drawn from <code>${render.boardName}</code>@if(render.hasAlternates) —
                    this design has ${render.alternates} other board file@if(render.alternates > 1)s@endif
                    not shown@endif.
                No switches or keycaps: this is the board as manufactured.
            </figcaption>
        </figure>
    @endif

    <%-- THE RAIL: this board's other pictures, small. Layout silhouettes deliberately do
         NOT appear here -- they belong beside the layouts they describe, under Layouts,
         and they are reachable in the gallery from there.

         ONE BOARD ENTRY, NOT TWO. There was a separate "Bare PCB" thumb here beside the
         3D one until the owner pointed out they are the same picture: the 3D slide opens
         ON the poster and only becomes a model when someone asks for it, so a second
         still of the identical render earned nothing. Its honesty sentence moved onto
         this item's caption rather than being dropped with it.

         STILL A BUTTON REVEALED BY SCRIPT, not a link: there is no single file to point a
         reader without JavaScript at, since this entry is a poster that becomes a
         model. --%>
    @if(design.render != null)
        !{val render = design.render!!}
        <ul class="shot-rail">
            @if(renderLeads && design.photo != null)
                !{val photo = design.photo!!}
                <li>
                    <a class="shot shot-photo" href="${photo.url}" data-alt="Photo of an assembled ${design.name}">
                        <img src="${photo.url}" width="${photo.width}" height="${photo.height}" loading="lazy" alt="">
                        <span>Photo</span>
                    </a>
                    <span class="shot-photo-caption" hidden>@if(photo.creditUrl != null)An assembled ${design.name}. Photo: <a class="external" href="${photo.creditUrl}" rel="nofollow noopener" target="_blank">${photo.creditName}</a>.@else An assembled ${design.name}, from the project's own README.@endif</span>
                </li>
            @endif
            <li>
                <button type="button" class="shot shot-3d" hidden
                        data-model="${render.model}" data-poster="${render.poster}"
                        data-size="${render.modelSize}"
                        data-caption="The bare PCB, drawn from ${render.boardName}. No switches or keycaps: this is the board as manufactured.">
                    <img src="${render.poster}" width="1400" height="900" loading="lazy" alt="">
                    <span>Turn it in 3D@if(render.modelSize != "") &middot; ${render.modelSize}@endif</span>
                </button>
            </li>
        </ul>
    @endif

    <%-- DOOR B'S ENTRY POINT. ux.md 2.9's own first sentence -- "reached from a prominent
         link in the design page's stat block" -- and 3.1's mock puts it beside the stat
         tiles as a prominent button. The tile grid itself is unbuilt, so the
         chip rows above are what stands in for it and this sits directly under them.

         Until this shipped the route had NO inbound link from anywhere on the site: it was
         reachable only by typing the URL, which also left /parts/dev-board/:slug hanging
         off a page nothing pointed at.

         ux.md's mock shows a second button here for Door C, "build with parts I
         have". It is deliberately absent: /build-with is out of scope by map ticket 29, and a
         prominent link to a route that does not exist is worse than no link.

         Every design gets it unconditionally, which is measured rather than assumed: 275
         designs have wiring recorded so their SWITCHES section renders real rows, 187 are
         socketed, and only 6 of 324 reach a page that is all sentences and no rows. --%>
    <p class="what-fits">
        <a href="/designs/${design.slug}/compatible">What fits this board &rarr;</a>
        <%-- Backlog #47. NOFOLLOW: every design linking here is 329 doors into ~54,000
             noindexed pairs, and robots.txt closes the path anyway. The c key is ux.md 7.6's
             "compare with..." shortcut, additive over this link as that section requires. --%>
        <a class="compare-link" href="/designs/compare?a=${design.slug}" rel="nofollow"
           aria-keyshortcuts="c">Compare with another board &rarr;</a>
        <%-- SHARE, Forgejo #49, reworked 2026-09-26 to the owner's ask: "a share button like
             youtube has" -- and moved here from the byline the same day, beside the two
             other things a reader does with this page, as YouTube keeps it under the video. A pill that opens a panel with a row of round targets and the
             link in a box with Copy beside it.

             It is a POPOVER, not a script-built dialog: the popovertarget attribute opens it, Esc and
             a click outside close it, and none of that needs JavaScript, so a reader
             without it still gets every target and a link to select. The script adds only
             what cannot be markup -- Copy, and "More" for the phone's own share sheet.
             The targets are plain intent links: no SDK is loaded and nothing is asked of a
             third party until the reader picks one. They share the CANONICAL address, not
             the address bar's, which may carry a query. --%>
        !{val shareUrl = head.canonical ?: ""}
        !{val u = java.net.URLEncoder.encode(shareUrl, Charsets.UTF_8).replace("+", "%20")}
        !{val t = java.net.URLEncoder.encode(design.name, Charsets.UTF_8).replace("+", "%20")}
        <button type="button" class="share-open" popovertarget="share-panel">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4l8 7.5-8 7.5v-4.5c-5.5 0-9 1.6-12 5.5 1-5.5 4.2-10.6 12-11.5z"/></svg>Share
        </button>
    </p>
    <div id="share-panel" class="share-panel" popover aria-labelledby="share-title">
        <div class="share-head">
            <h2 id="share-title">Share</h2>
            <button type="button" class="share-close" popovertarget="share-panel" popovertargetaction="hide" aria-label="Close">&times;</button>
        </div>
        <ul class="share-targets">
                <li><a class="share-target round" style="--brand: #ff4500" href="https://www.reddit.com/submit?url=${u}&amp;title=${t}" target="_blank" rel="noopener nofollow">
                    <span class="share-disc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12c0 3.314 1.343 6.314 3.515 8.485l-2.286 2.286C.775 23.225 1.097 24 1.738 24H12c6.627 0 12-5.373 12-12S18.627 0 12 0Zm4.388 3.199c1.104 0 1.999.895 1.999 1.999 0 1.105-.895 2-1.999 2-.946 0-1.739-.657-1.947-1.539v.002c-1.147.162-2.032 1.15-2.032 2.341v.007c1.776.067 3.4.567 4.686 1.363.473-.363 1.064-.58 1.707-.58 1.547 0 2.802 1.254 2.802 2.802 0 1.117-.655 2.081-1.601 2.531-.088 3.256-3.637 5.876-7.997 5.876-4.361 0-7.905-2.617-7.998-5.87-.954-.447-1.614-1.415-1.614-2.538 0-1.548 1.255-2.802 2.803-2.802.645 0 1.239.218 1.712.585 1.275-.79 2.881-1.291 4.64-1.365v-.01c0-1.663 1.263-3.034 2.88-3.207.188-.911.993-1.595 1.959-1.595Zm-8.085 8.376c-.784 0-1.459.78-1.506 1.797-.047 1.016.64 1.429 1.426 1.429.786 0 1.371-.369 1.418-1.385.047-1.017-.553-1.841-1.338-1.841Zm7.406 0c-.786 0-1.385.824-1.338 1.841.047 1.017.634 1.385 1.418 1.385.785 0 1.473-.413 1.426-1.429-.046-1.017-.721-1.797-1.506-1.797Zm-3.703 4.013c-.974 0-1.907.048-2.77.135-.147.015-.241.168-.183.305.483 1.154 1.622 1.964 2.953 1.964 1.33 0 2.47-.81 2.953-1.964.057-.137-.037-.29-.184-.305-.863-.087-1.795-.135-2.769-.135Z"/></svg></span>Reddit</a></li>
                <li><a class="share-target" style="--brand: #000000" href="https://x.com/intent/post?url=${u}&amp;text=${t}" target="_blank" rel="noopener nofollow">
                    <span class="share-disc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/></svg></span>X</a></li>
                <li><a class="share-target" style="--brand: #1185fe" href="https://bsky.app/intent/compose?text=${t}%20${u}" target="_blank" rel="noopener nofollow">
                    <span class="share-disc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026"/></svg></span>Bluesky</a></li>
                <li><a class="share-target" style="--brand: #0866ff" href="https://www.facebook.com/sharer/sharer.php?u=${u}" target="_blank" rel="noopener nofollow">
                    <span class="share-disc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg></span>Facebook</a></li>
                <%-- DISCORD HAS NO SHARE INTENT: no URL opens it with a message filled in. So
                     the script copies the link first and then lets this open Discord, and the
                     status line says to paste; without the script it just opens Discord. --%>
                <li><a class="share-target share-discord" style="--brand: #5865f2" href="https://discord.com/channels/@me" target="_blank" rel="noopener nofollow">
                    <span class="share-disc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg></span>Discord</a></li>
                <li><a class="share-target" style="--brand: #25d366" href="https://wa.me/?text=${t}%20${u}" target="_blank" rel="noopener nofollow">
                    <span class="share-disc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></span>WhatsApp</a></li>
                <li><a class="share-target round" style="--brand: #26a5e4" href="https://t.me/share/url?url=${u}&amp;text=${t}" target="_blank" rel="noopener nofollow">
                    <span class="share-disc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg></span>Telegram</a></li>
                <li><a class="share-target" style="--brand: #626168" href="mailto:?subject=${t}&amp;body=${u}" target="_blank" rel="noopener nofollow">
                    <span class="share-disc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5h20a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1.4 2 8.6 6.2L20.6 7zM3 8.6V17h18V8.6l-9 6.5z"/></svg></span>Email</a></li>
                <li class="share-more-item" hidden><button type="button" class="share-target share-more" style="--brand: var(--muted)">
                    <span class="share-disc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 10a2 2 0 1 1 0 4 2 2 0 0 1 0-4zm7 0a2 2 0 1 1 0 4 2 2 0 0 1 0-4zm7 0a2 2 0 1 1 0 4 2 2 0 0 1 0-4z"/></svg></span>More</button></li>
        </ul>
        <div class="share-link">
            <input type="text" readonly value="${shareUrl}" aria-label="Link to this design">
            <button type="button" class="share-copy" hidden>Copy</button>
        </div>
        <p class="share-status" role="status" aria-live="polite"></p>
    </div>
    <%-- The heart (see the byline). localStorage "kb-hearts" is this browser's list, in the
         order hearted; the server only keeps totals. A failed request puts the button
         back, so the list and the count never disagree for long. --%>
    <script>
        (function () {
            var btn = document.querySelector("button.heart");
            if (!btn) return;
            var slug = btn.getAttribute("data-slug");
            function load() {
                try { var v = JSON.parse(localStorage.getItem("kb-hearts") || "[]"); return Array.isArray(v) ? v : []; }
                catch (e) { return []; }
            }
            function save(list) { try { localStorage.setItem("kb-hearts", JSON.stringify(list)); } catch (e) {} }
            function show(on) {
                btn.setAttribute("aria-pressed", on ? "true" : "false");
                btn.querySelector(".heart-icon").textContent = on ? "\u2665" : "\u2661";
            }
            show(load().indexOf(slug) !== -1);
            btn.disabled = false;
            btn.addEventListener("click", function () {
                var list = load();
                var on = list.indexOf(slug) === -1;
                save(on ? list.concat([slug]) : list.filter(function (s) { return s !== slug; }));
                show(on);
                btn.disabled = true;
                fetch("/designs/" + encodeURIComponent(slug) + "/heart", { method: on ? "PUT" : "DELETE" })
                    .then(function (r) { if (!r.ok) throw r; return r.json(); })
                    .then(function (t) { btn.querySelector(".heart-count").textContent = t.count; })
                    .catch(function () {
                        save(load().filter(function (s) { return s !== slug; }).concat(on ? [] : [slug]));
                        show(!on);
                    })
                    .finally(function () { btn.disabled = false; });
            });
        })();
    </script>

    <script>
        (function () {
            var panel = document.getElementById("share-panel");
            if (!panel) return;
            var field = panel.querySelector(".share-link input");
            var copy = panel.querySelector(".share-copy");
            var status = panel.querySelector(".share-status");
            var url = field.value;
            var timer;
            function say(text) {
                status.textContent = text;
                clearTimeout(timer);
                timer = setTimeout(function () { status.textContent = ""; }, 2500);
            }
            // A click in the box selects the whole link, the way YouTube's does.
            field.addEventListener("focus", function () { field.select(); });
            if (navigator.clipboard && navigator.clipboard.writeText) {
                copy.hidden = false;
                copy.addEventListener("click", function () {
                    navigator.clipboard.writeText(url).then(
                        function () { say("Link copied"); },
                        function () { field.select(); say("Could not copy -- the link is selected"); }
                    );
                });
            }
            var discord = panel.querySelector(".share-discord");
            if (discord && navigator.clipboard && navigator.clipboard.writeText) {
                // Not preventDefault: the copy is started in the click, while the page
                // still has the user's gesture, and Discord opens in its new tab regardless.
                discord.addEventListener("click", function () {
                    navigator.clipboard.writeText(url).then(
                        function () { say("Link copied -- paste it into Discord"); },
                        function () {}
                    );
                });
            }
            if (typeof navigator.share === "function") {
                var more = panel.querySelector(".share-more-item");
                more.hidden = false;
                more.querySelector("button").addEventListener("click", function () {
                    // AbortError is the reader closing the sheet, which is an answer, not a failure.
                    navigator.share({ title: document.title, url: url }).catch(function () {});
                });
            }
        })();
    </script>
    <script>
        document.addEventListener("keydown", function (e) {
            if (e.key !== "c" || e.metaKey || e.ctrlKey || e.altKey) return;
            // ux.md 7.6: no shortcut fires while typing, and none while the gallery owns
            // the keyboard -- PhotoSwipe's open lightbox is its own surface.
            var t = e.target;
            if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
            if (document.querySelector(".pswp--open")) return;
            var link = document.querySelector("a.compare-link");
            if (!link) return;
            e.preventDefault();
            link.click();
        });
    </script>

    <%-- Backlog #46: "how well is this design represented", as a percentage.
         ux.md §5.3 -- one stat line, not the per-group "Help fill" breakdown that
         section also describes, which is a separate, unbuilt contribution flow. The
         bar is aria-hidden because the sentence beside it already carries the
         number a screen reader needs. NO BACKTICKS IN THIS FILE.

         OWNER-REQUESTED 2026-09-16, then 2026-09-17: the stat line itself is the
         <summary>, so the field-by-field accounting it summarises (a field that can
         never be Unknown still gets a line -- real accounting, not a magic number
         padded out of sight) is one click away with no separate "Which fields"
         trigger competing for attention. --%>
    <details class="completeness">
        <summary>
            Record ${design.completeness.percent}% complete &middot;
            ${design.completeness.known} of ${design.completeness.total} fields
            <span class="completeness-bar" aria-hidden="true">${design.completeness.bar}</span>
        </summary>
        <ul class="completeness-fields">
            @for(field in design.completeness.fields)
                @if(field.known)
                    <li class="fits">&check; ${field.label}</li>
                @else
                    <li class="excluded">&cross; ${field.label}</li>
                @endif
            @endfor
        </ul>
    </details>

    <%-- THE SUMMARY IS A QUOTATION AND IT SAYS SO. The sentence is the author's, copied
         verbatim from their README, and printing it unattributed would be this site
         claiming to have written a description of someone else's keyboard. The credit
         line is not decoration: it is what makes the claim checkable in one click, and
         seed/summaries.toml only drafts a row where the repo holds ONE design, so the
         first source is always the repo the sentence was read from.

         NOTE FOR THE NEXT EDIT: a backtick anywhere in here, even inside a comment,
         closes the content block this template is wrapped in and the error you get
         names a line thirty rows away. --%>
    @if(design.summary != null)
        <blockquote class="summary">
            <p>${design.summary}</p>
            @if(!design.sources.isEmpty())
                <footer>From the project&rsquo;s README &middot;
                    <a class="external" href="${design.sources.get(0)}" target="_blank"
                       rel="nofollow noopener" title="Opens in a new tab">${design.sources.get(0)}<svg class="ext" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
                </footer>
            @endif
        </blockquote>
    @else
        <p class="summary unrecorded">No summary recorded.</p>
    @endif

    <h2>Layouts</h2>
    <ul class="layouts">
        @for(layout in design.layouts)
            <li>
                ${layout.label}
                @if(layout.silhouette != null)
                    <%-- role="button"/tabindex, not an <a>: there is no separate file this
                         points at, only the inline SVG itself, so the gallery script below
                         is the only thing that can make it interactive at all. --%>
                    <span class="thumb thumb-clickable" role="button" tabindex="0">$unsafe{layout.silhouette}</span>
                @endif
            </li>
        @endfor
    </ul>

    <%-- ONE GALLERY FOR EVERY PICTURE ON THIS PAGE -- backlog #101. In order: the hero,
         the bare PCB where the hero is a photo rather than the board, every layout
         silhouette, and last of all the 3D model. PhotoSwipe (photoswipe.com, MIT,
         vendored under static/vendor), measured at ~23 KB gzipped for the library plus
         its stylesheet and loaded only on the first click -- the same "nobody pays for
         what they do not use" rule the 3D model itself has always followed.

         SILHOUETTES ARE RASTERISED ONTO A CANVAS with currentColor baked to white. An
         img or a canvas cannot see the page's own text colour the way inline SVG can,
         which is Silhouettes.kt's whole reason for being inline, and the lightbox
         backdrop is dark under either site theme. Drawn at 2x because it is vector art
         rasterised once: oversampling costs nothing and survives a pinch-zoom.

         THE BOARD SLIDE IS AN ORDINARY PICTURE THAT A MODEL CAN TAKE OVER. It is a plain
         image item, so it zooms exactly like every other slide; pressing the 3D control
         lays a model-viewer over it and hides the picture underneath, and pressing it
         again gives the picture back. PhotoSwipe drags to change slide and model-viewer
         drags to orbit, and the two cannot both own the same pixels -- so while the model
         is up it owns them, and the way off the slide is that control or the close button,
         both always visible. Measured on a phone, where PhotoSwipe hides its arrows: a
         swipe over the model is the model's, and swiping works again the moment the model
         is dismissed.

         Owner's reason for this shape, 2026-09-17: a model swapped into the small hero
         slot instead would be "quite hard to do if the size is not really big". --%>
    <script type="module">
        const items = [];

        // The width and height ATTRIBUTES are the intrinsic size in every case here (the
        // template writes the photo's real dimensions, and the renderer's posters are
        // always 1400x900), so they beat naturalWidth -- which is 0 until a lazily loaded
        // image has actually arrived, and these thumbs are lazy on purpose.
        // Captions are read off the page rather than restated in script, so the sentence
        // under the hero and the sentence in the lightbox cannot drift apart.
        function text(selector) {
            const el = document.querySelector(selector);
            return el ? el.textContent.replace(/\s+/g, " ").trim() : "";
        }

        // captionFrom is the page's own caption element, for a slide whose caption holds a
        // link -- an outside photo's credit -- that textContent alone would flatten.
        function picture(el, caption, captionFrom) {
            if (!el) return;
            const img = el.querySelector("img");
            const index = items.length;
            items.push({
                src: el.href,
                width: Number(img.getAttribute("width")) || img.naturalWidth || 1,
                height: Number(img.getAttribute("height")) || img.naturalHeight || 1,
                alt: el.dataset.alt || img.alt,
                caption: caption,
                captionFrom: captionFrom || null,
            });
            el.addEventListener("click", (e) => { e.preventDefault(); open(index); });
        }

        // THE HERO IS A SLIDE OF ITS OWN ONLY WHEN IT IS THE PHOTO. Where the hero is the
        // render, it is the very same file the 3D slide opens on, and making a slide of it
        // too put the identical picture in the gallery twice -- owner: "other designs with
        // no photo also has 3 images since they have BOTH the 3d render AND the 3d model?!"
        // So in that case the hero's click opens the 3D slide instead, which shows exactly
        // that poster with the load button on it. A design with a photo is unaffected: the
        // photo leads, the 3D slide trails, and they are different pictures.
        const hero = document.querySelector("figure.hero a.hero-shot");
        const heroIsRender = hero !== null && hero.dataset.hero === "render";
        if (hero && !heroIsRender) {
            picture(hero, text("figure.hero figcaption"), document.querySelector("figure.hero figcaption"));
        }

        const model = document.querySelector(".shot-rail button.shot-3d");
        let modelItem = null;
        function addModelSlide() {
            if (!model) return;
            model.hidden = false;
            // The board sentence comes from whichever place already states it on the page:
            // the hero's own caption when the hero IS this render (it carries the
            // "other board file not shown" clause too), and the rail button's otherwise.
            const base = heroIsRender ? text("figure.hero figcaption")
                                      : (model.dataset.caption || "");
            // AN ORDINARY PICTURE SLIDE, and the model arrives on top of it later.
            //
            // This started as custom HTML content -- a div holding the poster and the load
            // button -- and both of the owner's complaints came from that one decision:
            // "it only zooms in like 2%, and the Load 3D Model button is also being zoomed."
            // PhotoSwipe zooms the CONTAINER it is given, so the button rode along inside
            // it, and the zoom levels were computed from that container rather than from
            // the picture. Handing PhotoSwipe a plain image instead gets the native
            // behaviour for free: fit, double-tap to 1:1, pinch, exactly like every other
            // slide. The button moves out of the content and into PhotoSwipe's own UI
            // layer, which sits above the zoom wrap and therefore never scales.
            // THE TEMPLATE'S 1400x900 IS A PLACEHOLDER here, corrected by measurePoster()
            // before the gallery is ever opened. Measuring it at THIS point instead is what
            // introduced a window in which clicking the hero followed its plain href and
            // navigated to the raw PNG: setup awaited, so the handler below did not exist
            // yet. Nothing in this function may await for that reason.
            modelItem = { kind: "model",
                          src: model.dataset.poster,
                          width: 1400, height: 900, sized: false,
                          alt: "The bare circuit board, rendered",
                          base: base, caption: base + " Load the model to turn it." };
            const index = items.length;
            items.push(modelItem);
            model.addEventListener("click", () => open(index));
            if (heroIsRender && hero) {
                hero.addEventListener("click", (e) => { e.preventDefault(); open(index); });
            }
        }

        // First place when it is the hero, last when the photo is.
        if (heroIsRender) addModelSlide();

        // The photo in the rail, where /settings put the render first: right after it.
        const railPhoto = document.querySelector(".shot-rail a.shot-photo");
        if (railPhoto) {
            picture(railPhoto, text(".shot-rail .shot-photo-caption"),
                    document.querySelector(".shot-rail .shot-photo-caption"));
        }

        async function rasterize(svg, width, height) {
            const clone = svg.cloneNode(true);
            clone.querySelectorAll("[fill=\"currentColor\"]").forEach((el) => el.setAttribute("fill", "#fff"));
            const xml = new XMLSerializer().serializeToString(clone);
            const dataUrl = "data:image/svg+xml;base64," + btoa(unescape(encodeURIComponent(xml)));
            const image = new Image();
            image.src = dataUrl;
            await image.decode();
            const oversample = 2;
            const canvas = document.createElement("canvas");
            canvas.width = width * oversample;
            canvas.height = height * oversample;
            canvas.getContext("2d").drawImage(image, 0, 0, canvas.width, canvas.height);
            return canvas.toDataURL("image/png");
        }

        for (const thumb of document.querySelectorAll(".layouts .thumb-clickable")) {
            const svg = thumb.querySelector("svg");
            const w = Number(svg.getAttribute("width")) || 100;
            const h = Number(svg.getAttribute("height")) || 100;
            const scale = Math.min(6, 700 / Math.max(w, h));
            const width = w * scale, height = h * scale;
            const index = items.length;
            const label = svg.getAttribute("aria-label") || "";
            items.push({ src: await rasterize(svg, width, height), width, height,
                         alt: label,
                         caption: label ? "Layout: " + label : "" });
            thumb.addEventListener("click", () => open(index));
            thumb.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(index); }
            });
        }

        if (!heroIsRender) addModelSlide();

        // No early return anywhere in here -- this is a script type="module", not a
        // function body, so a top-level return is a syntax error. It is not needed: every
        // lookup above is null-guarded and an empty items array simply never opens.
        let lightbox = null;
        // THE POSTER'S REAL SIZE, read once, just before the gallery is first shown.
        // PhotoSwipe scales an image to the size it is TOLD, so a wrong number both
        // distorts the picture and puts the zoom levels somewhere they do not belong --
        // and the template's width="1400" height="900" IS wrong: that is what the renderer
        // is asked for, but it trims to the board, so this one is really 1376x872.
        async function measurePoster() {
            if (!modelItem || modelItem.sized) return;
            modelItem.sized = true;
            const probe = new Image();
            probe.src = modelItem.src;
            await probe.decode().catch(() => {});
            if (probe.naturalWidth && probe.naturalHeight) {
                modelItem.width = probe.naturalWidth;
                modelItem.height = probe.naturalHeight;
            }
        }

        async function open(index) {
            await measurePoster();
            if (!lightbox) {
                const [{ default: PhotoSwipeLightbox }] = await Promise.all([
                    import("/vendor/photoswipe-lightbox-5.4.4.esm.min.js"),
                    stylesheet("/vendor/photoswipe-5.4.4.css"),
                ]);
                lightbox = new PhotoSwipeLightbox({
                    dataSource: items,
                    pswpModule: () => import("/vendor/photoswipe-5.4.4.esm.min.js"),
                });
                // A caption per slide. PhotoSwipe ships no caption UI of its own, and the
                // strings come off the page itself (see text() above) so the sentence
                // under the hero and the sentence in the lightbox cannot drift.
                lightbox.on("uiRegister", () => {
                    lightbox.pswp.ui.registerElement({
                        name: "caption",
                        order: 9,
                        isButton: false,
                        appendTo: "root",
                        onInit: (el, pswp) => {
                            caption = el;
                            el.className = "pswp-caption";
                            const update = () => {
                                const data = pswp.currSlide && pswp.currSlide.data;
                                if (data && data.captionFrom) {
                                    el.replaceChildren(...data.captionFrom.cloneNode(true).childNodes);
                                } else {
                                    el.textContent = (data && data.caption) || "";
                                }
                                el.hidden = !el.textContent;
                            };
                            pswp.on("change", update);
                            update();
                        },
                    });
                    // THE 3D CONTROL LIVES IN THE UI LAYER, NOT IN THE SLIDE. That is the
                    // whole reason it no longer scales with a pinch: PhotoSwipe's UI sits
                    // above the zoom wrap and is never transformed. It shows on the board
                    // slide and nowhere else, and it TOGGLES -- owner: "can we also have
                    // that button still there but for 'Exit 3D Mode'?" -- so a reader who
                    // has waited for the model can put it away and get the picture back
                    // without leaving the slide, then bring it back for free.
                    // ONLY WHERE THERE IS A MODEL. Its syncModel reads model.dataset, and
                    // a design with a photo and no render has no model button: that threw
                    // inside PhotoSwipe's own setup and no photo on the page would open --
                    // pando, pando58, junco and six more, 2026-09-29.
                    if (model) lightbox.pswp.ui.registerElement({
                        name: "load3d",
                        order: 8,
                        isButton: true,
                        appendTo: "root",
                        onInit: (el, pswp) => {
                            control = el;
                            el.className = "pswp-load3d";
                            el.addEventListener("click", () => toggleModel(pswp, el));
                            pswp.on("change", () => syncModel(pswp));
                            syncModel(pswp);
                        },
                    });
                });
                lightbox.init();
            }
            lightbox.loadAndOpen(index);
        }

        function stylesheet(href) {
            return new Promise((resolve) => {
                const link = document.createElement("link");
                link.rel = "stylesheet";
                link.href = href;
                link.onload = resolve;
                document.head.appendChild(link);
            });
        }
        // THE MODEL IS AN OVERLAY ABOVE THE SLIDE, not the slide's own content. The slide
        // stays an ordinary picture of the board (see addModelSlide for why), and once a
        // reader asks for the model it is laid over that picture, inside PhotoSwipe's root
        // but outside the zoom wrap -- so nothing about it is scaled by a pinch.
        //
        // The viewer OUTLIVES the overlay. PhotoSwipe destroys its root on close, so the
        // overlay is rebuilt per open, and the same model-viewer element is moved back into
        // it: a reader who waited megabytes for a model keeps it, and no second WebGL
        // context is ever created.
        let viewer = null;
        let overlay = null;
        let caption = null;
        let control = null;
        let modelShowing = false;
        let loading = null;

        function sizeSuffix() {
            return model.dataset.size ? " (" + model.dataset.size + ")" : "";
        }

        // THE ONE PLACE THAT DECIDES WHAT THE BOARD SLIDE LOOKS LIKE, called on every slide
        // change and after every toggle, so there is no second copy of these rules to drift.
        function syncModel(pswp) {
            const onBoard = !!(pswp.currSlide && pswp.currSlide.data.kind === "model");
            const showing = onBoard && modelShowing && !!viewer;

            if (showing) {
                if (!overlay || !pswp.element || !pswp.element.contains(overlay)) {
                    overlay = buildOverlay();
                    pswp.element.appendChild(overlay);
                }
                overlay.querySelector(".pswp-3d-stage").appendChild(viewer);
                overlay.style.display = "";
            } else if (overlay) {
                overlay.style.display = "none";
            }

            // HIDES THE POSTER UNDERNEATH, which is the whole of the owner's report: "when
            // I click the Load 3D Model button, I get the 3D model WITH the png still in
            // the background." The model's own background is transparent and its box does
            // not cover the whole picture, so the render showed around and behind it.
            if (pswp.element) pswp.element.classList.toggle("pswp--model-on", showing);

            if (control) {
                control.style.display = onBoard ? "" : "none";
                control.disabled = loading !== null;
                control.textContent = loading !== null ? loading
                                     : !viewer ? ("Load 3D Model" + sizeSuffix())
                                     : showing ? "Exit 3D" : "Show 3D";
            }
            if (caption && onBoard) {
                modelItem.caption = modelItem.base +
                    (showing ? " Drag to turn it."
                             : viewer ? "" : " Load the model to turn it.");
                caption.textContent = modelItem.caption;
                caption.hidden = !modelItem.caption;
            }
        }

        async function toggleModel(pswp, button) {
            if (viewer) {
                modelShowing = !modelShowing;
                syncModel(pswp);
                return;
            }
            // THE BUTTON IS THE PROGRESS INDICATOR, because the bar was not one. There was
            // a 3px bar slotted into model-viewer, and measured under throttling it renders
            // at y=997 of a 1000px viewport in pure black on PhotoSwipe's pure black
            // backdrop -- invisible by construction, which is what the owner reported. This
            // control is already the thing being pressed and the thing being looked at.
            loading = "Loading…";
            button.disabled = true;
            syncModel(pswp);
            await loadModel(pswp);
            loading = null;
            modelShowing = true;
            syncModel(pswp);
        }

        function buildOverlay() {
            const wrap = document.createElement("div");
            wrap.className = "pswp-3d";
            const box = document.createElement("div");
            box.className = "pswp-3d-stage";
            wrap.appendChild(box);

            // THE STAGE SWALLOWS ITS OWN GESTURES, and this is load-bearing rather than
            // belt-and-braces. pointer-events governs hit-TESTING, not propagation: a
            // pointerdown on the model still bubbles to the .pswp root PhotoSwipe listens
            // on, so PhotoSwipe was starting a swipe (or a drag-down-to-close) at the same
            // time model-viewer started orbiting. Measured in a real browser: four drags
            // on the board left the gallery on slide 2 of 4 with the model torn down --
            // owner's report, "it works first few seconds, and then the board disappears
            // ... not possible to get it back".
            //
            // WHO OWNS THE GESTURE IS DECIDED ONCE, AT POINTERDOWN, IN THE CAPTURE PHASE,
            // so a drag that began somewhere else keeps reaching PhotoSwipe even as it
            // passes over the model. Capture on the window runs before either listener, so
            // the flag is already right by the time anything acts on it.
            //
            // WHILE THE MODEL IS UP IT OWNS THE WHOLE PICTURE, and the way off the slide is
            // the Exit 3D control or the close button rather than a gesture. Measured on a
            // phone: PhotoSwipe hides its arrows there, a swipe over the model is the
            // model's, and after tapping Exit 3D swiping works again immediately.
            //
            // keydown is deliberately not in this list: the arrow keys must always be able
            // to leave the slide, whatever the pointer is doing.
            let owning = false;
            window.addEventListener("pointerdown", (e) => { owning = box.contains(e.target); }, true);
            for (const type of ["pointerdown", "pointermove", "pointerup", "pointercancel"]) {
                box.addEventListener(type, (e) => { if (owning) e.stopPropagation(); });
            }
            // Not part of a drag, so these need no ownership test -- a wheel or a
            // double-click over the model is always the model's.
            for (const type of ["wheel", "click", "dblclick"]) {
                box.addEventListener(type, (e) => e.stopPropagation());
            }
            return wrap;
        }

        // The measured findings in these comments are why each attribute is here.
        async function loadModel(pswp) {
            // BACK TO FIT FIRST. The board slide is an ordinary zoomable picture now, so a
            // reader may well have zoomed into it before pressing this -- and the overlay
            // is positioned against the viewport, not against a zoomed picture.
            try {
                const slide = pswp.currSlide;
                if (slide && slide.currZoomLevel !== slide.zoomLevels.initial) {
                    slide.zoomTo(slide.zoomLevels.initial, undefined, 0);
                }
            } catch (ignored) { /* a model at the wrong zoom beats no model */ }

            await import("/vendor/model-viewer-4.3.1.min.js");

            viewer = document.createElement("model-viewer");
            viewer.setAttribute("src", model.dataset.model);
            // reveal="manual" PLUS the poster is what keeps a picture on screen while the
            // model downloads; without it the viewer clears to an empty box for seconds.
            viewer.setAttribute("reveal", "manual");
            viewer.setAttribute("poster", model.dataset.poster);
            // THE OPENING CAMERA IS EXPLICIT because the default one opens on the
            // UNDERSIDE of the board, which carries far less copper and reads washed out
            // next to its own poster. Tilted to match the poster's own --rotate -30,0,25,
            // so pressing the button changes the detail, not the subject.
            viewer.setAttribute("camera-orbit", "-20deg 125deg auto");
            // NEUTRAL TONE MAPPING AND A DIMMED EXPOSURE, chosen against KiCad's own
            // renderer: model-viewer's default filmic curve lifts and desaturates
            // saturated mid-tones, and PCB green is exactly that, so the board arrived a
            // pale sage while the poster beside it was deep green.
            viewer.setAttribute("tone-mapping", "neutral");
            viewer.setAttribute("exposure", "0.7");
            viewer.setAttribute("camera-controls", "");
            // none, not the pan-y this used on the page: inside the lightbox there is no
            // page to scroll past the model, and orbiting needs both axes.
            viewer.setAttribute("touch-action", "none");
            viewer.setAttribute("shadow-intensity", "1");
            // The label carries the fact, not the word "model", same rule the
            // silhouette's aria-label follows.
            viewer.setAttribute("alt",
                "Rotatable 3D view of the circuit board. Drag to turn it.");

            // REAL MEASURED PROGRESS, because the download is megabytes and an unmeasured
            // wait is indistinguishable from a hang. It goes in the button rather than in a
            // bar: see toggleModel for the measurement that condemned the bar.
            viewer.addEventListener("progress", (e) => {
                const pct = Math.round(e.detail.totalProgress * 100);
                loading = pct >= 100 ? "Preparing…" : "Loading… " + pct + "%";
                if (control) control.textContent = loading;
            });

            // SHOWN WHILE IT DOWNLOADS, not after. The viewer has to be in the document to
            // fetch at all, and putting it there now means the reader watches the poster
            // with a counting button rather than a frozen page.
            modelShowing = true;
            syncModel(pswp);

            // DISMISS FIRST, THEN WAIT. reveal="manual" means the model does not begin
            // loading until this call, so awaiting the load event before it deadlocks --
            // measured, the button sat on "Preparing…" until the timeout fired.
            viewer.dismissPoster();

            // AND THE BUTTON KEEPS SAYING SO UNTIL THE MODEL IS ACTUALLY READY. Resolving
            // when the element merely exists is what let it flip to "Exit 3D" seconds early,
            // with nothing on screen having changed yet. The timeout is a floor under a
            // model that never fires: a stuck label is worse than a wrong one.
            await new Promise((resolve) => {
                viewer.addEventListener("load", resolve, { once: true });
                viewer.addEventListener("error", resolve, { once: true });
                setTimeout(resolve, 120000);
            });
        }
    </script>

    <h2>Spec</h2>
    <%-- Grouped 2026-09-25, owner-agreed, under the rail's own order and words. --%>
    @for(section in design.specSections)
    <h3 class="spec-section">${section.heading}</h3>
    <dl class="spec">
        @for(line in section.lines)
            <%-- The label leads to the learn page explaining it, where one does (#108);
                 the value's own links, below, still lead to the catalog. --%>
            <dt>@if(line.learnHref != null)<a href="${line.learnHref}">${line.label}</a>@else${line.label}@endif</dt>
            @if(!line.terms.isEmpty())
                <%-- ux.md 3.1: every detail page a lateral-exploration surface, and an
                     internal-link farm for crawlers. --%>
                <%-- Comma-separated, and a term with no link is plain text: "Mill-Max, or
                     solder the switches in". --%>
                <dd>@for(term in line.terms)@if(term !== line.terms.first()), @endif@if(term.href != null)<a href="${term.href}">${term.text}</a>@else${term.text}@endif@endfor</dd>
            @elseif(line.recorded && line.hint != null)
                <%-- The long form on hover (owner, 2026-09-16). A title attribute rather
                     than a JS popover: facetOption.kte already uses one, it needs no
                     script, and the browser's own tooltip is the one users know. The abbr
                     carries it because a bare title on a dd gives no sign there is
                     anything to hover; CSS puts a dotted underline under it.
                     NO BACKTICKS IN THIS FILE -- one closes the layout raw string and the
                     compiler then blames a line nowhere near it. --%>
                <dd><abbr class="hinted" title="${line.hint}">${line.value}</abbr></dd>
            @elseif(line.recorded)
                <dd>${line.value}</dd>
            @else
                <dd class="unrecorded">&mdash; ${line.value} &mdash;</dd>
            @endif
        @endfor
    </dl>
    @endfor

    <h2>Licensing</h2>
    <dl class="spec">
        @for(line in design.licenses)
            <dt>${line.label}</dt>
            <dd>${line.value}</dd>
        @endfor
    </dl>

    <%-- EVERY LINK HERE POINTS OFF-SITE, so every one of them opens in a new tab and
         carries the arrow-out-of-box glyph that says it will. A source is cited so a
         reader can check the claim, and checking it should not cost them the page the
         claim was made on. The svg is aria-hidden and the anchor carries the title,
         because the link text is a bare URL and the glyph adds nothing to read out. --%>
    <h2>Sources</h2>
    <ul class="sources">
        @for(url in design.sources)
            <li><a class="external" href="${url}" target="_blank" rel="nofollow noopener"
                  title="Opens in a new tab">${url}<svg class="ext" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a></li>
        @endfor
    </ul>

    <%-- BOARDS LIKE THIS -- ux.md 3.6, backlog #24's sibling gap. Empty for a design
         whose recorded facets are too sparse or too unusual to weight-match anything,
         which is a real state and not an error -- no section renders rather than an
         empty "Boards like this" heading with nothing under it.

         SAME CARD AS THE HOME PAGE'S SHOP WINDOW (card.kte, strip-card), deliberately: a
         reader who has already seen that pattern once should not have to learn a
         second one for the same kind of link-to-a-design-with-a-picture. The reason
         line is the one thing the shop window does not have, because RelatedDesigns
         is the only place a reason exists to give. --%>
    @if(!design.related.isEmpty())
        <h2 class="strip-head related-head">Boards like this</h2>
        <ul class="strip">
            @for(item in design.related)
                <li>@template.designs.card(card = item.card, cls = "strip-card", reason = item.reason)</li>
            @endfor
        </ul>
    @endif
`)
