@import net.keyboardbuilders.keyboardbuilders.web.DesignCard
@import gg.jte.Content
@param card: DesignCard
@param cls: String
@param full: Boolean = false
@param reason: String? = null
@param href: String? = null
@param rel: String? = null
@param compare: Boolean = true
<%-- ONE CARD, TWO SURFACES: the home page's daily strip ("strip-card") and the /designs
     grid ("result-card"), which box it differently -- the strip's box is the link, the
     grid's is its li, whose measured size OffscreenRowsTest holds. `full` adds the
     electronics line. (The "N% complete" chip went 2026-11-27: owner, not useful while
     browsing; the percentage stays on the design page.)

     No photo means the drawing fills the photo's place at the catalogue's own scale, so
     every card has one shape and sizes still compare.

     `reason` is "boards like this"'s one addition, ux.md 3.6: a related card must say why
     it is there. `href` and `rel` are the compare chooser's: the same card, leading to
     the pair instead of the design.

     A card with several drawn layouts stacks one frame per layout and cycles them on
     hover (app.css, "CYCLING LAYOUTS"); the key count chip marks the count on show. --%>
!{val picture: Content = @`@if(card.row.cycles)<span class="cycle">@for(f in card.row.frames.withIndex())<span class="frame f${f.index} n${card.row.frames.size}">$unsafe{f.value.svg}</span>@endfor</span>@else$unsafe{card.row.silhouette}@endif`}
<div class="card-wrap">
<a class="${cls} card" href="${href ?: "/designs/" + card.row.slug}" rel="${rel}">
    @if(card.photo != null)
        <span class="card-photo">
            <img src="${card.photo}" alt="${card.row.name}@if(card.rendered), PCB render@else, built@endif" loading="lazy">
            <%-- The owner's favourite detail: the board's own drawing, small, over its
                 photo. Fit to its chip on purpose -- a label, not a size comparison. --%>
            @if(card.drawn)<span class="card-badge">${picture}</span>@endif
            @if(card.row.stars != null)<span class="card-stars" title="GitHub stars">&#9733; ${card.row.stars}</span>@endif
        </span>
    @else
        <span class="card-photo no-photo">
            <span class="card-drawn">${picture}</span>
            @if(card.row.stars != null)<span class="card-stars" title="GitHub stars">&#9733; ${card.row.stars}</span>@endif
        </span>
    @endif
    <span class="card-text">
        <span class="card-title">
            <span class="name">${card.row.name}</span>
            @if(card.by != null)<span class="card-by">by ${card.by}</span>@endif
        </span>
        <span class="facts">
            @for(chip in card.row.shape)@if(card.row.cycles && chip == card.row.keysChip)<span>@for(part in card.row.keyCounts.withIndex())@if(part.index > 0) / @endif@if(part.value.frame != null)<span class="cycle-count f${part.value.frame} n${card.row.frames.size}">${part.value.keys}</span>@else${part.value.keys}@endif@endfor keys</span>@else<span>${chip}</span>@endif@endfor
        </span>
        @if(full)
            <span class="facts">
                @for(chip in card.row.electronics)<span>${chip}</span>@endfor
            </span>
        @endif
        @if(reason != null)<span class="related-reason">${reason}</span>@endif
    </span>
</a>
<%-- COMPARE, BOTTOM LEFT (owner, 2026-11-27): press it on one card, then on another, and
     the pair opens -- static/compare.js, which keeps the first pick for this tab. Without
     the script it is what it looks like, a link to the page that asks for the second
     design. Off on the compare chooser's own cards, which already lead to a pair.
     NOFOLLOW for the design page's compare link's reason: 54,000 noindexed pairs. --%>
@if(compare)<a class="card-compare" href="/designs/compare?a=${card.row.slug}" rel="nofollow" data-slug="${card.row.slug}" data-name="${card.row.name}">Compare</a>@endif
<%-- THE HEART BUTTON, BOTTOM RIGHT, BESIDE THE LINK AND NOT IN IT (owner, 2026-11-27): a
     count in the photo's chip "doesn't look clickable", so it is a real button with an
     edge, and it carries the count the chip used to. A button inside an <a> is invalid
     HTML, hence `.card-wrap`; app.css places it and leaves the card text room for it.
     Disabled until static/hearts.js wakes it, so without JS the count still reads. --%>
<button type="button" class="heart card-heart" data-slug="${card.row.slug}" aria-pressed="false" disabled title="Heart ${card.row.name}"><span class="heart-icon" aria-hidden="true">&#9825;</span>@if(card.row.hearts != null) <span class="heart-count">${card.row.hearts}</span>@endif</button>
</div>
