@import net.keyboardbuilders.keyboardbuilders.web.CompatiblePage
@import net.keyboardbuilders.keyboardbuilders.web.Head
@import net.keyboardbuilders.keyboardbuilders.web.SiteUrl
@param page: CompatiblePage
@param head: Head
@param site: SiteUrl

@template.layout(head = head, site = site, content = @`
    <p class="crumb"><a href="/designs/${page.slug}">&larr; ${page.name}</a></p>

    <h1>${page.name} &mdash; what fits</h1>


    <h2>Controller</h2>
    @if(page.controllerMessage != null)
        <p class="summary unrecorded">${page.controllerMessage}</p>
    @else
        <%-- Wireless shown open, wired behind a disclosure -- pro_micro alone has 26
             catalogue rows, and a flat dump defeats a site whose other half is about
             narrowing choices. No ranking claim is made either way (see
             DesignPresentation.kt's CompatiblePage doc): this is a real fact
             (wireless/wired) doing the sorting, not a fabricated popularity count. --%>
        @if(!page.controllerWireless.isEmpty())
            <ul class="fit-list">
                @for(row in page.controllerWireless)
                    <li class="fits"><a href="/parts/dev-board/${row.slug}">${row.name}</a> &mdash; wireless</li>
                @endfor
            </ul>
        @endif
        <%-- #98. These fit the socket and run none of this design's firmware, so they are
             NOT in the list above -- the 2026-09-03 ruling (a ZMK-only board shown as a
             plain option for a QMK design) still stands. The caveat rides in the summary
             line, because behind a disclosure that is the only text a reader is sure to
             see. Above the wired group: a reader who came for "can this be wireless" is
             answered before being offered nineteen boards that cannot. --%>
        @if(page.controllerNeedsFirmwareSummary != null)
            <details class="needs-firmware">
                <summary>${page.controllerNeedsFirmwareSummary}</summary>
                <ul class="fit-list">
                    @for(row in page.controllerNeedsFirmware)
                        <li class="fits-socket"><a href="/parts/dev-board/${row.slug}">${row.name}</a> &mdash; drops in; needs the firmware config</li>
                    @endfor
                </ul>
            </details>
        @endif
        @if(page.controllerWiredSummary != null)
            <details>
                <summary>${page.controllerWiredSummary}</summary>
                <ul class="fit-list">
                    @for(row in page.controllerWired)
                        <li class="fits"><a href="/parts/dev-board/${row.slug}">${row.name}</a></li>
                    @endfor
                </ul>
            </details>
        @endif
    @endif

    <h2>Switches</h2>
    @if(page.switchesNote != null)
        <%-- Sensing unrecorded: the rows below compare footprints only, and this says so.
             It once replaced the rows (ticket 16 decision 3 rule 2); see SwitchesSection. --%>
        <p class="summary unrecorded">${page.switchesNote}</p>
    @endif
        <ul class="fit-list">
            @for(row in page.switchRows)
                @if(row.fits)
                    <li class="fits">&check; ${row.footprint}</li>
                @else
                    <li class="excluded">&cross; ${row.footprint} &mdash; ${row.exclusion}</li>
                @endif
            @endfor
        </ul>

    <h2>Keycaps</h2>
    <%-- SIX SENTENCES, ONE LIST. Which keycaps fit is a function of two independent axes --
         the stem the cap presses onto and the largest cap the board's spacing allows
         (architecture.md 1.5) -- so the reasons an answer is unavailable are genuinely
         different facts and each gets its own sentence rather than a shared "unknown".
         DesignPresentation.kt's keycapFacts() holds the order and the reasoning; the
         message is precomputed there for the same reason the controller section's is. --%>
    @if(page.keycapMessage != null)
        <p class="summary unrecorded">${page.keycapMessage}</p>
    @else
        <ul class="fit-list">
            @for(row in page.keycapRows)
                <li class="fits">
                    @if(row.url != null)
                        <%-- The profile's own source or vendor page, not /parts/keycap-profile/:slug:
                             ux.md's sitemap names that route and PartsController wires only
                             dev-board, so linking it would promise a page that 404s. --%>
                        <a href="${row.url}" rel="nofollow noopener">${row.name}</a>
                    @else
                        ${row.name}
                    @endif
                </li>
            @endfor
        </ul>
    @endif

`)
